@model IEnumerable<MoulineWarehouse.Models.StockItem>

<h2>В запасе</h2>

<p>
    <a class="btn btn-primary" href="/StockItems/Create">Добавить</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Цвет</th>
            <th>Производитель</th>
            <th>Наличие</th>
            <th>В резерве</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ThreadColor?.Code</td>
                <td>@item.ThreadColor?.Manufacturer</td>
                <td>@item.Quantity</td>
                <td>@item.ReservedQuantity</td>
                <td>@(item.Quantity > 0 ? "Да" : "Нет")</td>
                <td>
                    <a class="btn btn-sm btn-info" asp-action="Edit" asp-route-id="@item.Id">Редактировать</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
